<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.digitallib.FichaExportConfigEditorController"
            prefWidth="1100" prefHeight="720">

    <!-- ══════════ TOP TOOLBAR ══════════ -->
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <Label text="Configurações de Ficha-catálogo" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ══════════ THREE-PANEL CENTER ══════════ -->
    <center>
        <HBox spacing="0">

            <!-- ── LEFT: Config list ── -->
            <VBox spacing="6" prefWidth="200" style="-fx-border-color: #ddd; -fx-border-width: 0 1 0 0;">
                <padding><Insets top="10" right="8" bottom="8" left="8"/></padding>
                <Label text="Configurações" style="-fx-font-weight: bold;"/>
                <ListView fx:id="configListView" VBox.vgrow="ALWAYS"/>
                <HBox spacing="4">
                    <Button fx:id="btnNew"       text="Nova"      onAction="#handleNew"       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnDuplicate" text="Duplicar"  onAction="#handleDuplicate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="4">
                    <Button fx:id="btnDelete"    text="Deletar"   onAction="#handleDelete"    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRename"    text="Renomear"  onAction="#handleRename"    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Separator/>
                <Button text="Importar JSON…" onAction="#handleImport"  maxWidth="Infinity"/>
                <Button text="Exportar JSON…" onAction="#handleExportJson" maxWidth="Infinity"/>
            </VBox>

            <!-- ── CENTER: Filter rules ── -->
            <VBox fx:id="filterPanel" spacing="6" prefWidth="260" disable="true"
                  style="-fx-border-color: #ddd; -fx-border-width: 0 1 0 0;">
                <padding><Insets top="10" right="8" bottom="8" left="8"/></padding>
                <Label text="Filtros de Série" style="-fx-font-weight: bold;"/>

                <Label text="Série:"/>
                <ComboBox fx:id="filterClasseCombo" maxWidth="Infinity"/>
                <Label text="Subsérie (deixar vazio para incluir qualquer):"/>
                <ComboBox fx:id="filterSubClasseCombo" maxWidth="Infinity" editable="false"/>
                <Button text="Adicionar filtro" onAction="#handleAddFilter" maxWidth="Infinity"/>

                <Separator/>
                <Label text="Filtros adicionados:" style="-fx-font-weight: bold;"/>
                <ListView fx:id="filterRuleListView" VBox.vgrow="ALWAYS"/>
                <Button text="Remover selecionado" onAction="#handleRemoveFilter" maxWidth="Infinity"/>
            </VBox>

            <!-- ── RIGHT: Block list + block editor ── -->
            <VBox fx:id="blocksPanel" spacing="6" HBox.hgrow="ALWAYS" disable="true">
                <padding><Insets top="10" right="8" bottom="8" left="8"/></padding>
                <Label text="Grupos de dados para exportação" style="-fx-font-weight: bold;"/>
                <HBox spacing="0" VBox.vgrow="ALWAYS">
                    <!-- Block list -->
                    <VBox spacing="4" prefWidth="220" style="-fx-border-color: #ddd; -fx-border-width: 0 1 0 0; -fx-padding: 0 8 0 0;">
                        <ListView fx:id="blockListView" VBox.vgrow="ALWAYS" prefHeight="300"/>
                        <HBox spacing="4">
                            <Button text="+"  onAction="#handleAddBlock"    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="−"  onAction="#handleRemoveBlock" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="↑"  onAction="#handleMoveBlockUp"  maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="↓"  onAction="#handleMoveBlockDown" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Block inline editor -->
                    <VBox fx:id="blockEditorPane" spacing="6" HBox.hgrow="ALWAYS" visible="false" managed="false">
                        <padding><Insets left="8"/></padding>
                        <Label text="Editar grupo" style="-fx-font-weight: bold;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Tipo de Grupo:"/>
                            <ComboBox fx:id="blockTypeCombo" onAction="#handleBlockTypeChanged"/>
                            <CheckBox fx:id="blockEnabledCheck" text="Habilitado"/>
                        </HBox>
                        <Label fx:id="blockLayoutHintLabel"
                               style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-background-color: #f5f5f5; -fx-padding: 4 6 4 6; -fx-border-color: #ddd; -fx-border-radius: 3; -fx-background-radius: 3;"
                               wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Título opcional para o grupo:"/>
                            <TextField fx:id="blockLabelField" HBox.hgrow="ALWAYS" promptText="(opcional)"/>
                        </HBox>

                        <!-- RELATED_STUDIES specific -->
                        <VBox fx:id="relatedStudiesPane" spacing="4" visible="false" managed="false"
                              style="-fx-background-color: #f0f4ff; -fx-padding: 8; -fx-border-color: #b0c4e8; -fx-border-radius: 4; -fx-background-radius: 4;">
                            <Label text="Tipo de Relação:"/>
                            <ComboBox fx:id="relationTypeCombo" maxWidth="Infinity"/>
                            <Label text="ℹ Os campos controlam apenas o cabeçalho; as referências são geradas automaticamente."
                                   style="-fx-font-size: 11px; -fx-text-fill: #555;" wrapText="true"/>
                        </VBox>

                        <!-- Field list (hidden for RELATED_STUDIES) -->
                        <VBox fx:id="fieldListPane" spacing="4" visible="true" managed="true">
                            <Label text="Campos:" style="-fx-font-weight: bold;"/>
                            <ListView fx:id="fieldListView" prefHeight="130"/>
                            <HBox spacing="4">
                                <Button text="+"  onAction="#handleAddField"      maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="−"  onAction="#handleRemoveField"   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="↑"  onAction="#handleMoveFieldUp"   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="↓"  onAction="#handleMoveFieldDown" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <VBox fx:id="fieldEditPane" spacing="4" visible="false" managed="false">
                                <Separator/>
                                <Label text="Editar campo selecionado:" style="-fx-font-weight: bold;"/>
                                <GridPane hgap="8" vgap="4">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="110" maxWidth="110"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Dados descritivos:"       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="fieldLabelField" promptText="(opcional)"
                                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                    <Label text="Fonte dos Dados:"        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <ComboBox fx:id="fieldSourceCombo" maxWidth="Infinity"
                                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                    <Label fx:id="fieldLiteralLabel" text="Dado fixo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="fieldLiteralField" promptText="ex: . ou ["
                                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <HBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="0" alignment="CENTER_LEFT">
                                        <Label text="Formato:"/>
                                        <Button text="?" onAction="#handleFormatInfo" style="-fx-background-radius: 50%; -fx-min-width: 20; -fx-min-height: 20; -fx-padding: 0; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <TextField fx:id="fieldFormatField" promptText="ex: %02d"
                                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                    <Label text="Opções:"     GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1">
                                        <CheckBox fx:id="fieldLabelBoldCheck" text="Dados des. negrito"/>
                                        <CheckBox fx:id="fieldValueBoldCheck" text="Valor negrito"/>
                                        <CheckBox fx:id="fieldItalicCheck"    text="Itálico"/>
                                    </HBox>
                                </GridPane>
                                <Button text="Aplicar campo" onAction="#handleApplyField" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>

                        <!-- ── Preview ── -->
                        <Separator/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Pré-visualização" style="-fx-font-weight: bold;"/>
                            <Button text="↻ Atualizar" onAction="#handleRefreshPreview"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" minHeight="80" style="-fx-background-color: white; -fx-border-color: #ddd;">
                            <TextFlow fx:id="previewTextFlow" style="-fx-background-color: white; -fx-padding: 8;"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <!-- ══════════ FOOTER ══════════ -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <Label fx:id="statusLabel" HBox.hgrow="ALWAYS" style="-fx-text-fill: gray;"/>
            <Button fx:id="btnSave"      text="Salvar"         onAction="#handleSave"        style="-fx-font-weight: bold;" disable="true"/>
            <Button fx:id="btnExportNow" text="Exportar Agora" onAction="#handleExportNow"   style="-fx-font-weight: bold; -fx-base: #4CAF50; -fx-text-fill: white;" disable="true"/>
            <Button text="Fechar"      onAction="#handleClose"/>
        </HBox>
    </bottom>

</BorderPane>

